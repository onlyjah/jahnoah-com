---
import '../styles/global.css';import Connect from '../components/Connect';
const {title='Jah Noah — Development & Public Speaking',description='Jah Noah. Development, public speaking, yoga, and art.'}=Astro.props;
const canonical=new URL(Astro.url.pathname,'https://jahnoah.com');
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta name="twitter:card" content="summary"/><link rel="alternate" type="application/rss+xml" title="Jah Noah journal" href="/feed.xml"/><link rel="icon" href="/favicon.svg"/></head><body><a href="#main" class="skip">Skip to content</a><div class="shell"><header class="topbar"><a class="logo" href="/">Jah Noah.</a><nav class="nav" aria-label="Main navigation">{['Journal','ark'].map(page=><a href={`/${page}`} aria-current={Astro.url.pathname.split('/')[1]===page?'page':undefined}>{page}</a>)}<Connect client:load/></nav></header><main id="main"><slot/></main><footer class="footer"><a class="logo" href="/">Jah Noah.</a><div class="footer-links"><a href="/about/">About Jah Noah</a><a href="https://onlyjah.com">OnlyJah <span class="link-kind">External ↗</span></a><a href="/credits/">Photo credits</a><a href="/feed.xml">Journal RSS · XML feed</a></div><span class="small">© {new Date().getFullYear()} Jah Noah</span></footer></div></body></html>
