---
import {getCollection} from 'astro:content';const {limit=99}=Astro.props;const entries=(await getCollection('journal',({data})=>!data.draft)).sort((a,b)=>b.data.date.getTime()-a.data.date.getTime()).slice(0,limit);
---
<div>{entries.map(post=><a class="journal-row" href={`/Journal/${post.id}/`}><time class="date" datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US',{month:'short',day:'2-digit',year:'numeric',timeZone:'UTC'})}</time><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="tag">{post.data.category}</span></a>)}</div>
