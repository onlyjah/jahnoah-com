---
const {discipline}=Astro.props;
const quotes=discipline==='Yoga'?[{text:'Wisdom follows the exercise of reasoning in peace, and reason follows the practice of studying, questioning, reflecting and inquiring into the nature of truth.',name:'Sebai Maa · Muata Ashby',url:'https://egyptianyoga.com/new-book-project-starting-soon-on-this-site-2/'},{text:'If God is anything, God is a mathematician.',name:'Quoted on TutemRa.com',url:'https://tutemra.com'}]:discipline==='Arts'?[{text:'It’s the way I enjoy making art — I like sitting down and making five beats; I enjoy that process.',name:'J. Cole · NPR interview, 2013',url:'https://www.kosu.org/music/2013-06-23/j-cole-on-competition-and-writing-honest-songs'},{text:'Since our earliest days, America has flourished because of the creative spirit and vision of our people.',name:'Barack Obama · Arts and Humanities Month, 2014',url:'https://obamawhitehouse.archives.gov/realitycheck/the-press-office/2014/09/30/presidential-proclamation-national-arts-and-humanities-month-2014'}]:[{text:'The FIRST spirit encourages doing high-quality, well-informed work in a manner that leaves everyone feeling valued.',name:'Dr. Woodie Flowers · FIRST',url:'https://ftc-docs.firstinspires.org/en/latest/gracious_professionalism/gp.html'},{text:'Go Go Gadget!',name:'Inspector Gadget · Fictional character',url:'https://www.wildbrain.com/trade-news/wildbrain-pok%C3%A9mon-to-launch-fast-channel-on-pluto-tv-on-oct-22'}];
const links=discipline==='Yoga'?[['Egyptian Yoga · Book inspiration','https://muataashby.com/books/series/egyptian-yoga/s168eq'],['Little Book of Neter · Publisher PDF','https://egyptianyoga.com/wp-content/uploads/2016/01/9781884564581-Book-Text-Little-Book-of-Neter-EBOOK.pdf'],['TutemRa · Books & resources','https://tutemra.com']]:discipline==='Arts'?[['Adam’s Ribs · SoundCloud','https://m.soundcloud.com/kj9e4/adams-ribs'],['Left Behind · SoundCloud','https://m.soundcloud.com/kj9e4/left-behind']]:[['OnlyJah · Forge / Ark','https://onlyjah.com'],['Source projects · GitHub','https://github.com/onlyjah'],['Scott Greven · FIRST 744 mentor profile','https://sharkattack744.com/home/about/mentors/'],['Surveillance Self-Defense · EFF','https://ssd.eff.org/']];
const image=discipline==='Yoga'?'flowers':discipline==='Arts'?'rainbow':'dragonfly';
---
<section class="resource-garden"><figure><img src={`/images/${image}.webp`} alt={discipline==='Yoga'?'Wildflower meadow':discipline==='Arts'?'Rainbow across the sky':'Dragonfly perched on a twig'} loading="lazy" width="1280" height="960"/><figcaption><a href={`/credits/#${image}`}>Commons photograph · Credits</a></figcaption></figure><div><h2>{discipline==='Yoga'?'Study & inspiration':discipline==='Arts'?'Art & inspiration':'Build & explore'}</h2>{quotes.map(q=><blockquote><p>“{q.text}”</p><cite><a href={q.url}>{q.name} <span class="link-kind">External ↗</span></a></cite></blockquote>)}<ul class="resource-links">{links.map(([label,url])=><li><a href={url}>{label} <span class="link-kind">External ↗</span></a></li>)}</ul></div></section>
