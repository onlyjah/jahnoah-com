---
import {getCollection,render} from 'astro:content';import Base from '../../layouts/Base.astro';
import {topicFeatures} from '../../data/topics';
export async function getStaticPaths(){const posts=await getCollection('journal',({data})=>!data.draft);return posts.map(post=>({params:{id:post.id},props:{post}}));}const {post}=Astro.props;const {Content}=await render(post);
---
<Base title={`${post.data.title} — Jah Noah`} description={post.data.description}><article class="article journal-article"><a class="text-link" href="/Journal/">Journal</a><h1>{post.data.title}</h1><div class="article-meta"><span>Jah Noah</span><time datetime={post.data.date.toISOString()}>{post.data.dateType==='Captured'?'Captured ':''}{post.data.date.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time><nav class="article-topics" aria-label="Entry topics">{post.data.tags.map(tag=><a href={`/${tag}/`}>{topicFeatures[tag].label}</a>)}</nav></div><div class="prose"><Content/></div>{post.data.kind?.startsWith('Archived')&&post.data.sourceUrl&&<p class="archive-credit">{post.data.kind==='Archived excerpt'?'Excerpt · ':''}<a href={post.data.sourceUrl}>Wayback Machine ↗</a></p>}</article></Base>
