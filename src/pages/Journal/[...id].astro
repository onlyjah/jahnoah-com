---
import {getCollection,render} from 'astro:content';import Base from '../../layouts/Base.astro';
export async function getStaticPaths(){const posts=await getCollection('journal',({data})=>!data.draft);return posts.map(post=>({params:{id:post.id},props:{post}}));}const {post}=Astro.props;const {Content}=await render(post);
---
<Base title={`${post.data.title} — Jah Noah`} description={post.data.description}><article class="article"><a class="text-link" href="/Journal/">The journal</a><p class="eyebrow" style="margin-top:45px">{post.data.category} · {post.data.date.toLocaleDateString('en-US',{month:'long',year:'numeric',timeZone:'UTC'})}</p><h1>{post.data.title}</h1><p class="lede">{post.data.description}</p><p class="small">By Jah Noah · {post.data.dateType==='Captured'?'Archive capture · ':''}<time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('en-US',{month:'long',day:'numeric',year:'numeric',timeZone:'UTC'})}</time></p>{post.data.kind&&<p class="source-note">{post.data.kind}{post.data.kind?.startsWith('Archived')&&<> · Historical text</>}{post.data.sourceUrl&&<> · <a href={post.data.sourceUrl}>Original source <span class="link-kind">External ↗</span></a></>}</p>}<div class="prose"><Content/></div></article></Base>
