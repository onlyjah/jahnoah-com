---
import Resources from '../components/Resources.astro';import Base from '../layouts/Base.astro';import Connect from '../components/Connect';
export function getStaticPaths(){return [{params:{discipline:'Tech'},props:{title:'Development'}},{params:{discipline:'Yoga'},props:{title:'Yoga'}},{params:{discipline:'Arts'},props:{title:'Arts'}}];}const {title}=Astro.props;
const skills=[['Programming','Python, C++, Java, TypeScript, Arduino, Raspberry Pi, Microcontrollers'],['Virtual Infrastructure','Kubernetes, Cilium CNI, Gateway API, Linux Server, Networking'],['Web Development','Vue, React, Node.js, WebComponents, PostgreSQL, Blockchain, APIs'],['Misc','Git, Markdown, Encryption, Robotics, Documentation, Mentoring, Communication']];
---
<Base title={`${title} — Jah Noah`} description={`Jah Noah. ${title}.`}><article class="article"><h1>{title}</h1>{title==='Development'?<><p class="lede">Systems Solutions</p><div class="prose"><h2>Notable Skills</h2><ul>{skills.map(([label,tools])=><li><strong>{label}:</strong> {tools}</li>)}</ul><h2>Freelance Systems Engineer - Systems Solutions</h2><p>Apr 2025 - Present</p><ul><li>Assisted in developing integrated systems, e-commerce shops, and blockchain applications</li><li>Set up remote environments for global access to mission-critical development infrastructure</li><li>Delivered solutions for authors, educators, artists, political leaders, and a variety of businesses</li><li>Translated complex technical concepts into mundane terminology for ease of receptivity</li></ul><h2>Software Development Intern - Museum of Discovery and Science</h2><p>Nov 2017 - May 2019</p><ul><li>Developed mobile augmented reality applications using Unity game engine and Autodesk Maya</li><li>Collected and analyzed in-person and virtual feedback to inform our iterative improvements</li><li>Team-orientated, multidisciplinary collaboration and continuous integration for production apps</li></ul><h2>Office Depot HQ Hackathon - 2nd Place Winner</h2><p>2021</p><ul><li>Django + AWS app to crowdsource goods and services during natural disasters - 24 hours</li></ul><h2>FIRST Robotics Team 108 SigmaC@Ts - Software Lead</h2><p>2018-2019</p><ul><li>Developed control systems for autonomous way-finding, manual control, and hybrid modes</li><li>Studied and lead workshops on system design, OpenCV vision tracking, C++, Java, and more</li></ul><p><a href="/resumes/tech-resume.pdf" download>Technical résumé · Download PDF ↓</a> · <a href="https://github.com/onlyjah/jah">Source résumé <span class="link-kind">External ↗</span></a></p></div><Connect kind="development" client:load/></>:title==='Yoga'?<><p class="lede">Certified Yoga Instructor - SmaiTawi, Sema Institute, Dec 2023</p><div class="prose"><h2>Facilitation & Technical Expertise</h2><ul><li>Leading individual and group yogic experiences using breath, movement, and insight, guiding both seasoned and beginner participants towards happy, healthy lives</li><li>Developing educational building blocks and resources for clients to learn, explore and understand their day to day, lived experiences</li></ul><h2>Yoga Instructor – Florida Memorial University (February 2026 - Ongoing)</h2><ul><li>Introduced yoga and its benefits to inexperienced participants in a clear and relatable way</li><li>Maintain a balanced pace for the time allotted while being attentive to individual participant capacities and skill levels</li><li>Present alternative postures for those of reduced strength, flexibility, and range of motion</li></ul><p><a href="/resumes/yoga-cover-letter.pdf" download>Yoga qualifications · Download PDF ↓</a></p></div><Connect kind="yoga" client:load/></>:<div class="prose"><h2>Music</h2><p><a href="https://m.soundcloud.com/kj9e4/adams-ribs">Adam’s Ribs <span class="link-kind">External ↗</span></a></p><p><a href="https://m.soundcloud.com/kj9e4/left-behind">Left Behind <span class="link-kind">External ↗</span></a></p></div>}<Resources discipline={title}/></article></Base>
