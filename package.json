{
  "name": "jahnoah",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "node scripts/compile-journal.mjs && vp dev --host 0.0.0.0",
    "build": "node scripts/compile-journal.mjs && vp build && node scripts/finalize-static.mjs",
    "typecheck": "tsc --noEmit",
    "start": "node scripts/serve-static.mjs",
    "preview": "node scripts/serve-static.mjs",
    "check:static": "python3 scripts/verify-static.py",
    "check:ui": "node scripts/check-ui-snapshot.mjs",
    "check": "pnpm check:ui && pnpm build && pnpm typecheck && pnpm check:static && pnpm test",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@onlyjah/ui": "file:vendor/oj-ui",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "nitro": "3.0.260903-beta",
    "typescript": "7.0.2",
    "@types/node": "24.19.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "gray-matter": "4.0.3",
    "marked": "16.4.2",
    "marked-smartypants": "1.1.12"
  }
}
