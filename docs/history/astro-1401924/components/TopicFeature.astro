---
import Connect from './Connect';
import {topicFeatures,type Topic} from '../data/topics';
const {topic}=Astro.props as {topic:Topic};const feature=topicFeatures[topic];
---
<header class={`topic-feature topic-${topic}`}><h1>{feature.label}</h1><p class="lede">{feature.headline}</p>{feature.banner&&<figure><img src={feature.banner.src} alt={feature.banner.alt} loading="eager"/><figcaption><a href={feature.banner.creditUrl}>{feature.banner.credit} · Credits ↗</a></figcaption></figure>}<div class="hero-actions">{feature.bookingUrl?<a class="ui-button" href={feature.bookingUrl}>Book {feature.label.toLowerCase()} consultation <span class="link-kind">External ↗</span></a>:<Connect kind={topic} label={`Consult · ${feature.label}`} client:load/>}{feature.paymentUrl&&<a class="ui-button ui-button-outline" href={feature.paymentUrl}>Pay for {feature.label.toLowerCase()} consultation <span class="link-kind">External checkout ↗</span></a>}</div>{feature.video&&<section class="yoga-video"><h2>{feature.video.title}</h2><p class="small">Jah Noah · YouTube</p><div class="video-frame"><iframe src={`https://www.youtube-nocookie.com/embed/${feature.video.id}`} title={`${feature.video.title} — Jah Noah`} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div><div class="video-links"><a href={`https://www.youtube.com/watch?v=${feature.video.id}`}>Watch on YouTube <span class="link-kind">External ↗</span></a><a href="https://www.youtube.com/@Jah_noah">Jah_Noah channel <span class="link-kind">External ↗</span></a></div></section>}</header>
